# Passwords and secrets for Serverpod development and testing.
# Copy this file to passwords.yaml and fill in your secrets.
shared:
  # MSG91 SMS Provider Configuration
  msg91AuthKey: 'your-msg91-auth-key'
  msg91TemplateId: 'your-msg91-template-id'
  msg91SenderId: 'SOCMGT'
  # Razorpay Payment Gateway Configuration (Test/Prod Mode)
  razorpayKeyId: 'rzp_test_society_key'
  razorpayKeySecret: 'rzp_test_secret_123456789'
  razorpayWebhookSecret: 'whsec_society_test_secret_987654321'
  # S3-compatible Cloud Storage (AWS, MinIO, Cloudflare R2, Wasabi)
  s3Endpoint: 'https://s3.ap-south-1.amazonaws.com'
  s3Bucket: 'society-documents-vault'
  s3Region: 'ap-south-1'
  s3AccessKeyId: 'your-s3-access-key-id'
  s3SecretAccessKey: 'your-s3-secret-access-key'
  # Firebase Cloud Messaging (FCM) Configuration
  fcmServerKey: 'your-fcm-server-key'
  fcmSenderId: 'your-fcm-sender-id'
development:
  database: 'your-database-password'
  redis: 'your-redis-password'
  serviceSecret: 'your-development-service-secret'
  jwtRefreshTokenHashPepper: 'your-jwt-refresh-token-hash-pepper'
  jwtHmacSha512PrivateKey: 'your-jwt-hmac-sha512-private-key-must-be-long-enough-for-sha512-signing'
  emailSecretHashPepper: 'your-email-secret-hash-pepper'
test:
  database: 'your-test-database-password'
  redis: 'your-test-redis-password'
  serviceSecret: 'your-test-service-secret'
  jwtRefreshTokenHashPepper: 'your-jwt-refresh-token-hash-pepper'
  jwtHmacSha512PrivateKey: 'your-jwt-hmac-sha512-private-key-must-be-long-enough-for-sha512-signing'
  emailSecretHashPepper: 'your-email-secret-hash-pepper'
